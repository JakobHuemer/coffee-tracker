# Copy to .env and fill in. `docker compose` reads .env automatically.

# Secret used to sign and verify JWTs. MUST be at least 16 characters.
# Generate a strong random value, e.g.:  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret

# Host port to publish the app on. The container serves both / (frontend) and
# /api (backend) here. Internal container port is fixed at 3001.
PORT=8080

# Optional. Username of the protected "primary" admin. If a user with this name
# exists, they are made the super admin on every boot (no-op until they register).
# The super admin is the only one who can manage other admins (reset their
# password / demote them) and cannot itself be demoted or reset. Regular admins,
# whom the super admin promotes, can reset non-admin passwords and promote
# non-admins. All from the Profile page.
# ADMIN_USERNAME=

# Published image built by CI (.github/workflows/docker.yaml). Pull this
# instead of building locally. Tags: `latest` and `sha-<commit>`.
IMAGE=ghcr.io/jakobhuemer/coffee-tracker:latest

# Web Push (issue #87) — OPTIONAL. Leave all three unset to disable push; the
# app boots and works normally without them. To enable OS-level notifications
# (Android web push), generate a VAPID key pair once and set BOTH keys:
#     cd server && bun x web-push generate-vapid-keys
# Setting only one of the pair is a config error and the server refuses to boot.
# VAPID_SUBJECT is a contact URL the push services can reach you at (mailto: or
# https); it defaults to a mailto if left unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Debug only — leave unset in production. With DEV_OVERRIDES=1 the server will
# honour a per-request `skip_spacing` flag that bypasses the rule forbidding two
# coffees within 5 minutes of each other, so a dev can seed test data quickly.
# The matching toggle only appears on the Profile page when this is on.
# DEV_OVERRIDES=1
